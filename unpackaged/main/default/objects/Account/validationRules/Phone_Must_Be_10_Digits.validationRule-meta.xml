<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Must_Be_10_Digits</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Phone)),
    NOT(REGEX(SUBSTITUTE(Phone, &quot;-&quot;, &quot;&quot;), &quot;[0-9]{10}&quot;))
)</errorConditionFormula>
    <errorMessage>Phone number must be exactly 10 digits, numbers and dashes only (no parentheses, spaces, or letters).</errorMessage>
</ValidationRule>
