<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Usage_Minimum_Fee_Percentage_Ran</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Usage_Minimum_Fee_Percentage__c)),
  OR(
    Usage_Minimum_Fee_Percentage__c &lt; 0,
    Usage_Minimum_Fee_Percentage__c &gt; 100
  )
)</errorConditionFormula>
    <errorMessage>Usage Minimum Fee Percentage must be between 0 and 100 (e.g. 35 for 35%).</errorMessage>
</ValidationRule>
