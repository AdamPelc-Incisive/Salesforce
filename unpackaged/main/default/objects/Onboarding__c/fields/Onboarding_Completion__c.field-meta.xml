<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Onboarding_Completion__c</fullName>
    <formula>IF(ISBLANK(Total_Onboarding_Tasks__c) || Total_Onboarding_Tasks__c = 0, 
   0, 
   Total_Completed_Onboarding_Tasks__c / Total_Onboarding_Tasks__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Onboarding Completion</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
