<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="label" type="String" label="Field Label" default="Account Name"
                role="inputOnly"/>
            <property name="required" type="Boolean" label="Required" default="true"
                role="inputOnly"/>
            <property name="accountName" type="String" label="Account Name (typed)"
                role="outputOnly"/>
            <property name="selectedRecordId" type="String" label="Selected Existing Account Id"
                role="outputOnly"/>
            <property name="selectedAccountName" type="String" label="Selected Existing Account Name"
                role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
