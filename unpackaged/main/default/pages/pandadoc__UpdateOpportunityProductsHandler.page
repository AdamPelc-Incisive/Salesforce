<apex:page id="UpdateOpportunityProductsHandler"
    controller="pandadoc.UpdateOpportunityProductsHandlerCtrl"
    title="Update Opportunity Products Settings"
>
    <apex:form >
        <apex:pageBlock title="Update Opportunity Products Settings">
            <apex:pageBlockButtons >
                <apex:commandButton action="{!save}" value="Save" />
                <apex:commandButton action="{!getBack}" value="Cancel" rendered="{!retUrlExist}" />
            </apex:pageBlockButtons>
            <apex:pageMessages />
            <apex:pageBlockSection >
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Add/remove Opportunity Products"
                        for="isAddRemoveOpportunityProductsEnabled"
                    />
                    <apex:inputCheckbox value="{!settings.isAddRemoveOpportunityProductsEnabled}"
                        id="isAddRemoveOpportunityProductsEnabled"
                    />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info"
                        strength="1"
                        summary="Add/remove Opportunity Products when they are added, removed, opted in or out in the Pricing Table or Quote Builder"
                    />
                    <apex:pageMessage severity="warning"
                        strength="1"
                        summary="If you are using merge rules, and some products are filtered out from the document, they will be deleted from Opportunity Products"
                    />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Document statuses" />
                    <c:CheckBoxList checkBoxes="{!supportedStatusesCheckBoxes}" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info"
                        strength="1"
                        summary="Specify when to run Opportunity Products updates"
                    />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Execute when" />
                    <apex:outputPanel layout="block">
                        <apex:inputCheckbox value="{!settings.isRunOnQuoteSaved}" id="isRunOnQuoteSaved" />
                        <apex:outputLabel value="Quote is saved" for="isRunOnQuoteSaved" />
                    </apex:outputPanel>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>