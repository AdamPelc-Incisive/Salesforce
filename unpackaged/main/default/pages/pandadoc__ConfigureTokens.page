<apex:page id="ConfigureTokens" controller="pandadoc.ConfigureTokensCtrl" sideBar="false" tabStyle="PandaDoc_Setup__tab">
    <apex:includeScript value="{!URLFOR($Resource.pandadoc__SObjectMapper, '/configureTokens.js')}" />
    <apex:slds />

    <apex:form >
        <apex:actionFunction name="getBack" action="{!getBack}" />
    </apex:form>

    <div id="approot" class="slds-scope slds-m-around_x-small slds-p-around_small"></div>

    <script>
        console.log(JSON.parse('{!JSENCODE(initialState)}'));
        window.__initial_state__ = JSON.parse('{!JSENCODE(initialState)}');

        window.__global_config__ = {
            slds_assets: '{!JSENCODE(URLFOR($Asset.SLDS))}',
            cancel_method: getBack
        };

        window.__remote_actions__ = {
            'getObjectFields': '{!$RemoteAction.ConfigureTokensCtrl.getObjectFields}',
            'getFieldsFromRelation': '{!$RemoteAction.ConfigureTokensCtrl.getFieldsFromRelation}',
            'getObjectData': '{!$RemoteAction.ConfigureTokensCtrl.getObjectData}',
            'saveObject': '{!$RemoteAction.ConfigureTokensCtrl.saveObject}',
            'deleteObject': '{!$RemoteAction.ConfigureTokensCtrl.deleteObject}'
        };
    </script>
</apex:page>