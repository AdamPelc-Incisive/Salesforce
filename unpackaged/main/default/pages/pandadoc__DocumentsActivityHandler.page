<apex:page controller="pandadoc.DocumentsActivityHandlerCtrl" title="Document notifications settings">
    <apex:slds />
    <apex:includeScript value="{!URLFOR($Resource.pandadoc__SObjectMapper, '/configureDocumentsActivityTrigger.js')}" />

    <apex:form >
        <apex:actionFunction name="getBack" action="{!getBack}" />
    </apex:form>

    <div id="approot"></div>

    <script>
        window.__initial_state__ = JSON.parse('{!JSENCODE(initialState)}');
        window.__global_config__ = {
            slds_assets: '{!JSENCODE(URLFOR($Asset.SLDS))}',
            cancel_method: getBack
        }
        window.__remote_actions__ = {
            save: '{!$RemoteAction.DocumentsActivityHandlerCtrl.save}'
        };
    </script>
</apex:page>