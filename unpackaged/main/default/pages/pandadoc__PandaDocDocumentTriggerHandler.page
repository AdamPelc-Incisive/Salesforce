<apex:page id="PandaDocDocumentTriggerHandler"
        controller="pandadoc.PandaDocDocumentTriggerHandlerCtrl"
        title="PandaDoc attachments settings">

    <apex:form >
    <apex:pageBlock title="Attachment and Document Status Settings">
        <apex:pageBlockButtons >
            <apex:commandButton action="{!save}" value="Save"/>
            <apex:commandButton action="{!getBack}" value="Cancel" rendered="{!retUrlExist}" />
        </apex:pageBlockButtons>
        <apex:pageMessages />
        <apex:pageBlock title="sObject attachments settings">
            <apex:pageMessage severity="info" strength="2" summary="You can add a PDF version of the document to “Notes and Attachments” section in Salesforce whenever the document status changes. You can configure the naming convention of the PDF and specify when to add the PDF to the record."></apex:pageMessage>
            <apex:pageBlockSection >
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Attachment name format" for="nameFormatObject"/>
                    <apex:inputText required="true" value="{!settings.attachmentForDocumentNameFormat}" id="nameFormatObject" label="sObject attachment name"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info" strength="1" summary="Customize the name of the PDF using any of these tokens:  [documentName], [today], [now], [documentStatus]"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Document statuses"/>
                    <c:CheckBoxList checkBoxes="{!statusesAttachedToObjectsCheckBoxes}" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info" strength="1" summary="Specify when to attach the PDF to the record"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
        <apex:pageBlock title="Statuses history settings">
            <apex:pageBlockSection >
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Download attachments" for="downloadAttachmentsForVersions"/>
                    <apex:inputCheckbox value="{!settings.downloadAttachmentsForVersions}" id="downloadAttachmentsForVersions" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info" strength="1" summary="Need a downloaded version? Select box"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Attachment name format" for="nameFormatStatus"/>
                    <apex:inputText required="true" value="{!settings.attachmentForStatusNameFormat}" id="nameFormatStatus" label="Status attachment name"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info" strength="1" summary="Customize the name of the PDF using any of these tokens:  [documentName], [today], [now], [documentStatus]"/>
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Document statuses"/>
                    <c:CheckBoxList checkBoxes="{!statusesWithVersionsCheckBoxes}" />
                </apex:pageBlockSectionItem>
                <apex:pageBlockSectionItem >
                    <apex:pageMessage severity="info" strength="1" summary="Specify when to save the status"/>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:pageBlock>
    </apex:form>
</apex:page>