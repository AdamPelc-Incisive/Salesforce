    <description>Handles PandaDoc after-save sync on Opportunity — three sequential paths:
1. PDDoc_Billing_* changed → sync to Account billing address (fault email on failure)
2. PDDoc_ExhibitC_* changed → find Contact by email and update, or create new Contact linked to Account only if email + first name + last name are all present
3. PDDoc_Signer_* changed → find Contact by email and update first name, last name, title</description>
    <environments>Default</environments>
    <formulas>
        <name>AddressDifferent</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  BLANKVALUE({!NewBillingStreet},&quot;&quot;) &lt;&gt; BLANKVALUE({!Get_Account_Details.BillingStreet},&quot;&quot;),
  BLANKVALUE({!NewBillingCity},&quot;&quot;) &lt;&gt; BLANKVALUE({!Get_Account_Details.BillingCity},&quot;&quot;),
  BLANKVALUE({!NewBillingPostal},&quot;&quot;) &lt;&gt; BLANKVALUE({!Get_Account_Details.BillingPostalCode},&quot;&quot;),
  BLANKVALUE({!NewBillingStateCode},&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT({!Get_Account_Details.BillingStateCode}),&quot;&quot;),
  BLANKVALUE({!NewBillingCountryCode},&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT({!Get_Account_Details.BillingCountryCode}),&quot;&quot;),
  BLANKVALUE({!NewShippingStreet},&quot;&quot;) &lt;&gt; BLANKVALUE({!Get_Account_Details.ShippingStreet},&quot;&quot;),
  BLANKVALUE({!NewShippingCity},&quot;&quot;) &lt;&gt; BLANKVALUE({!Get_Account_Details.ShippingCity},&quot;&quot;),
  BLANKVALUE({!NewShippingPostal},&quot;&quot;) &lt;&gt; BLANKVALUE({!Get_Account_Details.ShippingPostalCode},&quot;&quot;),
  BLANKVALUE({!NewShippingStateCode},&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT({!Get_Account_Details.ShippingStateCode}),&quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingCity</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_Billing_City__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_Billing_City__c}),40),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.BillingCity}),40),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_Billing_City__c}),40),
  {!Get_Account_Details.BillingCity}
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingCountry</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_Billing_Country__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_Billing_Country__c}),80),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.BillingCountry}),80),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_Billing_Country__c}),80),
  {!Get_Account_Details.BillingCountry}
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingCountryCode</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS(
    &quot;;AL;AK;AZ;AR;CA;CO;CT;DE;FL;GA;HI;ID;IL;IN;IA;KS;KY;LA;ME;MD;MA;MI;MN;MS;MO;MT;NE;NV;NH;NJ;NM;NY;NC;ND;OH;OK;OR;PA;RI;SC;SD;TN;TX;UT;VT;VA;WA;WV;WI;WY;&quot;,
    &quot;;&quot; &amp; UPPER(TRIM({!$Record.PDDoc_Billing_State_Province__c})) &amp; &quot;;&quot;
  ),
  &quot;US&quot;,
  IF(
    ISBLANK(TEXT({!Get_Account_Details.BillingCountryCode})),
    &quot;&quot;,
    TEXT({!Get_Account_Details.BillingCountryCode})
  )
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingPostal</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_Billing_Zip_Postal_Code__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_Billing_Zip_Postal_Code__c}),20),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.BillingPostalCode}),20),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_Billing_Zip_Postal_Code__c}),20),
  {!Get_Account_Details.BillingPostalCode}
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingState</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_Billing_State_Province__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_Billing_State_Province__c}),80),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.BillingState}),80),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_Billing_State_Province__c}),80),
  {!Get_Account_Details.BillingState}
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingStateCode</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!NewBillingCountryCode} = &quot;US&quot;,
    LEN(TRIM({!$Record.PDDoc_Billing_State_Province__c})) = 2
  ),
  UPPER(TRIM({!$Record.PDDoc_Billing_State_Province__c})),
  TEXT({!Get_Account_Details.BillingStateCode})
)</expression>
    </formulas>
    <formulas>
        <name>NewBillingStreet</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_BillingStreet_c__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_BillingStreet_c__c}),255),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.BillingStreet}),255),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_BillingStreet_c__c}),255),
  {!Get_Account_Details.BillingStreet}
)</expression>
    </formulas>
    <formulas>
        <name>NewShippingCity</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_Shipping_City__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_Shipping_City__c}),40),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.ShippingCity}),40),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_Shipping_City__c}),40),
  {!Get_Account_Details.ShippingCity}
)</expression>
    </formulas>
    <formulas>
        <name>NewShippingPostal</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_Shipping_Zip_Postal_Code__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_Shipping_Zip_Postal_Code__c}),20),&quot;&quot;) &lt;&gt;
    BLANKVALUE(LEFT(TRIM({!Get_Account_Details.ShippingPostalCode}),20),&quot;&quot;)
  ),
  LEFT(TRIM({!$Record.PDDoc_Shipping_Zip_Postal_Code__c}),20),
  {!Get_Account_Details.ShippingPostalCode}
)</expression>
    </formulas>
    <formulas>
        <name>NewShippingStateCode</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN(TRIM({!$Record.PDDoc_Shipping_State_Province__c})) = 2,
  UPPER(TRIM({!$Record.PDDoc_Shipping_State_Province__c})),
  TEXT({!Get_Account_Details.ShippingStateCode})
)</expression>
    </formulas>
    <formulas>
        <name>NewShippingStreet</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK(TRIM({!$Record.PDDoc_ShippingStreet__c}))),
    BLANKVALUE(LEFT(TRIM({!$Record.PDDoc_ShippingStreet__c}),255),&quot;&quot;) &lt;&gt;
