<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Seed_PDDoc_Signer_From_Contact</name>
        <label>Seed PDDoc Signer From Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Signer_FirstName__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedSignerFirstName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Signer_LastName__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedSignerLastName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Signer_Title__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedSignerTitle</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Signer_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedSignerEmail</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Primary_Contact_Role_Found</name>
        <label>Primary Contact Role Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Primary Contact</defaultConnectorLabel>
        <rules>
            <name>Has_Primary_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varContactRole.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Primary_Contact</targetReference>
            </connector>
            <label>Primary Contact Found</label>
        </rules>
    </decisions>
    <description>When an Opportunity is created or updated, copies the primary Contact&#39;s first name, last name, title and email into PDDoc Signer fields. Only populates blank fields. Runs Before Save so values are present when PandaDoc document is created.</description>
    <environments>Default</environments>
    <formulas>
        <name>SeedSignerEmail</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Signer_Email__c}),
  {!varContact.Email},
  {!$Record.PDDoc_Signer_Email__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedSignerFirstName</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Signer_FirstName__c}),
  LEFT(TRIM({!varContact.FirstName}),80),
  {!$Record.PDDoc_Signer_FirstName__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedSignerLastName</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Signer_LastName__c}),
  LEFT(TRIM({!varContact.LastName}),80),
  {!$Record.PDDoc_Signer_LastName__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedSignerTitle</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Signer_Title__c}),
  LEFT(TRIM({!varContact.Title}),80),
  {!$Record.PDDoc_Signer_Title__c}
)</expression>
    </formulas>
    <interviewLabel>Opportunity · Before Save · Seed PandaDoc Signer from Primary Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity · Before Save · Seed PandaDoc Signer from Primary Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Primary_Contact</name>
        <label>Get Primary Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Seed_PDDoc_Signer_From_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varContactRole.ContactId</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>varContact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Title</queriedFields>
        <queriedFields>Email</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Primary_Contact_Role</name>
        <label>Get Primary Contact Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Primary_Contact_Role_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>OpportunityContactRole</object>
        <outputReference>varContactRole</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>ContactId</queriedFields>
        <sortField>IsPrimary</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Primary_Contact_Role</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varContact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>varContactRole</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityContactRole</objectType>
    </variables>
</Flow>
