<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Seed_PDDoc_Billing_From_Account</name>
        <label>Seed PDDoc Billing From Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_BillingStreet_c__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedBillingStreet</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Billing_City__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedBillingCity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Billing_Zip_Postal_Code__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedBillingPostal</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Billing_State_Province__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedBillingStateText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Billing_Country__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedBillingCountryText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_ShippingStreet__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedShippingStreet</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Shipping_City__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedShippingCity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Shipping_Zip_Postal_Code__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedShippingPostal</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.PDDoc_Shipping_State_Province__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SeedShippingStateText</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>When an Opportunity is created or Account changes, copies Account Billing and Shipping addresses into PDDoc fields. Only populates blank fields. Runs Before Save so values are present when PandaDoc document is created.</description>
    <environments>Default</environments>
    <formulas>
        <name>SeedBillingCity</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Billing_City__c}),
  LEFT(TRIM({!varAccount.BillingCity}),40),
  {!$Record.PDDoc_Billing_City__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedBillingCountryText</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Billing_Country__c}),
  TEXT({!varAccount.BillingCountryCode}),
  {!$Record.PDDoc_Billing_Country__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedBillingPostal</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Billing_Zip_Postal_Code__c}),
  LEFT(TRIM({!varAccount.BillingPostalCode}),20),
  {!$Record.PDDoc_Billing_Zip_Postal_Code__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedBillingStateText</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Billing_State_Province__c}),
  TEXT({!varAccount.BillingStateCode}),
  {!$Record.PDDoc_Billing_State_Province__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedBillingStreet</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_BillingStreet_c__c}),
  LEFT(TRIM({!varAccount.BillingStreet}),255),
  {!$Record.PDDoc_BillingStreet_c__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedShippingCity</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Shipping_City__c}),
  LEFT(TRIM({!varAccount.ShippingCity}),40),
  {!$Record.PDDoc_Shipping_City__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedShippingPostal</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Shipping_Zip_Postal_Code__c}),
  LEFT(TRIM({!varAccount.ShippingPostalCode}),20),
  {!$Record.PDDoc_Shipping_Zip_Postal_Code__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedShippingStateText</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_Shipping_State_Province__c}),
  TEXT({!varAccount.ShippingStateCode}),
  {!$Record.PDDoc_Shipping_State_Province__c}
)</expression>
    </formulas>
    <formulas>
        <name>SeedShippingStreet</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK({!$Record.PDDoc_ShippingStreet__c}),
  LEFT(TRIM({!varAccount.ShippingStreet}),255),
  {!$Record.PDDoc_ShippingStreet__c}
)</expression>
    </formulas>
    <interviewLabel>Opportunity · Before Save · Seed PandaDoc Billing Addresses from Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity · Before Save · Seed PandaDoc Billing Addresses from Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account_Details</name>
        <label>Get Account Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Seed_PDDoc_Billing_From_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>varAccount</outputReference>
        <queriedFields>BillingStreet</queriedFields>
        <queriedFields>BillingCity</queriedFields>
        <queriedFields>BillingPostalCode</queriedFields>
        <queriedFields>BillingStateCode</queriedFields>
        <queriedFields>BillingCountryCode</queriedFields>
        <queriedFields>ShippingStreet</queriedFields>
        <queriedFields>ShippingCity</queriedFields>
        <queriedFields>ShippingPostalCode</queriedFields>
        <queriedFields>ShippingStateCode</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
