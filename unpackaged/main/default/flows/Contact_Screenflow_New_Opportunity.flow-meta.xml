    <decisions>
        <description>OPS-356. Only users in a customer success role (CS, CS Leadership) trigger the alert.</description>
        <name>Is_CS_Role</name>
        <label>Is CS Role</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Upgrading_Scanners</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not CS</defaultConnectorLabel>
        <rules>
            <name>Yes_CS_Role</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Creator_Role.Name</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>CS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Organization_Info</targetReference>
            </connector>
            <label>Yes CS</label>
        </rules>
    </decisions>
    <decisions>
        <description>OPS-356. Only Expansion opportunities (Scanner Upgrade and New Scanner) alert. New Sales and anything else go straight on.</description>
        <name>Is_Expansion_Opportunity</name>
        <label>Is Expansion Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Upgrading_Scanners</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Expansion</defaultConnectorLabel>
        <rules>
            <name>Yes_Expansion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>newOpp.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>expansionRecordTypeID</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Creator_Role</targetReference>
            </connector>
            <label>Yes Expansion</label>
        </rules>
    </decisions>
