<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>addToAssetsToUpdate</name>
        <label>Add to Assets to Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>assetUpdateRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopPendingDownsellAssets</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>buildAssetUpdate</name>
        <label>Build Asset Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopPendingDownsellAssets.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Return</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status_Change_Notes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Lost retention opportunity</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>addToAssetsToUpdate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>resetAssetUpdateRecord</name>
        <label>Reset Asset Update Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>emptyAssetRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>buildAssetUpdate</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>hasPendingDownsellAssets</name>
        <label>Has Pending Downsell Assets?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>hasPendingDownsellAssetsYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getPendingDownsellAssets</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loopPendingDownsellAssets</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>When a Retention opportunity is Closed Lost, mark all Pending Downsell assets on the account as Pending Return and clear the Retention Opportunity lookup</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - After - Mark Assets Pending Return on Closed Lost Retention {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - After - Mark Assets Pending Return on Closed Lost Retention</label>
    <loops>
        <name>loopPendingDownsellAssets</name>
        <label>Loop Pending Downsell Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getPendingDownsellAssets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>resetAssetUpdateRecord</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>updateAssets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getPendingDownsellAssets</name>
        <label>Get Pending Downsell Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>hasPendingDownsellAssets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Downsell</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>updateAssets</name>
        <label>Update Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>assetsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getPendingDownsellAssets</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Lost</stringValue>
            </value>
        </filters>
        <filters>
            <field>Record_Type_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Retention</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>assetsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>assetUpdateRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>emptyAssetRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
</Flow>
