<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Assigned_or_Shipped</name>
        <label>Assigned or Shipped</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Assigned</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Complete_Stage_Task</targetReference>
            </connector>
            <label>Assigned</label>
        </rules>
        <rules>
            <name>Shipped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shipped</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Complete_Ship_Task</targetReference>
            </connector>
            <label>Shipped</label>
        </rules>
    </decisions>
    <description>Set the Ship or Stage task related to this device to completed when asset moves to either Assigned or Shipped.  Stamp tracking number for Shipped</description>
    <environments>Default</environments>
    <interviewLabel>Asset - After - Update Onboarding Task v2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Asset - After - Update Onboarding Task v2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Complete_Ship_Task</name>
        <label>Complete Ship Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Related_Asset_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Task__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Ship</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pre-Training</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tracking_Number__c</field>
            <value>
                <elementReference>$Record.Current_Assignment__r.Tracking_Number_Out__c</elementReference>
            </value>
        </inputAssignments>
        <object>Onboarding_Task__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Complete_Stage_Task</name>
        <label>Complete Stage Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Related_Asset_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Task__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>stage</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pre-Training</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>Onboarding_Task__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assigned_or_Shipped</targetReference>
        </connector>
        <filterFormula>AND(
  OR(ISPICKVAL({!$Record.Status}, &quot;Assigned&quot;), ISPICKVAL({!$Record.Status}, &quot;Shipped&quot;)),
  NOT(AND(ISPICKVAL({!$Record.Status}, &quot;Assigned&quot;), ISPICKVAL({!$Record__Prior.Status}, &quot;Assigned&quot;))),
  NOT(AND(ISPICKVAL({!$Record.Status}, &quot;Shipped&quot;), ISPICKVAL({!$Record__Prior.Status}, &quot;Shipped&quot;)))
)</filterFormula>
        <object>Asset</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
