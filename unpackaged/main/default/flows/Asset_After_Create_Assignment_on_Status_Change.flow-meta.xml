    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>createAssignment</targetReference>
        </connector>
        <filterFormula>AND(
  {!$Record.Product2.Serialized__c},
  OR(
    ISCHANGED({!$Record.Status}),
    ISCHANGED({!$Record.Billing_Start_Date__c}),
    ISCHANGED({!$Record.Billing_End_Date__c}),
    ISCHANGED({!$Record.Usage_Minimum__c})
  )
)</filterFormula>
        <object>Asset</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
