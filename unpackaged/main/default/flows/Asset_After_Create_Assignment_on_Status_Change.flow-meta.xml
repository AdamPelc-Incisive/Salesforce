<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Creates an Asset Assignment record for serialized Assets whenever Status, Billing_Start_Date__c, Billing_End_Date__c, or Usage_Minimum__c changes. This is the sole path in the org that creates Asset_Assignment__c records - all legacy writers have been migrated off as of INC3-91. Copies current billing and usage fields onto each new assignment row. (INC3-91, INC3-141)


2026-08-19: BN - Use ISCHANGED in entry criteria so blank-to-value changes on Usage Minimum and billing dates fire the flow.</description>
    <environments>Default</environments>
    <formulas>
        <name>billingEndDateChanged</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISBLANK({!$Record.Billing_End_Date__c}) &lt;&gt; ISBLANK({!$Record__Prior.Billing_End_Date__c}),
  {!$Record.Billing_End_Date__c} &lt;&gt; {!$Record__Prior.Billing_End_Date__c}
)</expression>
    </formulas>
    <formulas>
        <name>billingStartDateChanged</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISBLANK({!$Record.Billing_Start_Date__c}) &lt;&gt; ISBLANK({!$Record__Prior.Billing_Start_Date__c}),
  {!$Record.Billing_Start_Date__c} &lt;&gt; {!$Record__Prior.Billing_Start_Date__c}
)</expression>
    </formulas>
    <formulas>
        <name>computedStatusChangeNotes</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!$Record.Status_Change_Notes__c})),
  {!$Record.Status_Change_Notes__c},
  IF(
    {!statusFieldChanged},
    &quot;Auto-generated: Status changed without notes&quot;,
    IF(
      {!billingStartDateChanged},
      &quot;Auto-generated: Billing Start Date changed without notes&quot;,
      IF(
        {!billingEndDateChanged},
        &quot;Auto-generated: Billing End Date changed without notes&quot;,
        &quot;Auto-generated: Usage Minimum changed without notes&quot;
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>statusFieldChanged</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!$Record.Status}) &lt;&gt; TEXT({!$Record__Prior.Status})</expression>
    </formulas>
    <formulas>
        <name>usageMinimumChanged</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  ISBLANK({!$Record.Usage_Minimum__c}) &lt;&gt; ISBLANK({!$Record__Prior.Usage_Minimum__c}),
  {!$Record.Usage_Minimum__c} &lt;&gt; {!$Record__Prior.Usage_Minimum__c}
)</expression>
    </formulas>
    <interviewLabel>Asset - After - Create Assignment on Status Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Asset - After - Create Assignment on Status Change</label>
