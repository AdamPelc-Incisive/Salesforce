<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Stamps the Churn Date on a Dental Product and Lab record when it is updated to Status &quot;Lab Churn&quot; while Churn Date is still blank, so CS leadership can report on lab churn events by time period without cross-object reports. Runs before save (fast field update) to avoid a second DML. Entry criteria require a blank Churn Date (update only, not create), so the original churn date is preserved if the record re-enters Lab Churn later. (INC3-13)

2026-06-09: Moved the blank Churn Date check into the entry criteria and removed the decision element (INC3-13)</description>
    <environments>Default</environments>
    <interviewLabel>Dental Product and Lab - Before - Stamp Lab Churn Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Dental Product and Lab - Before - Stamp Lab Churn Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Stamp_Churn_Date</name>
        <label>Stamp Churn Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Churn_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Churn_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lab Churn</stringValue>
            </value>
        </filters>
        <filters>
            <field>Churn_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Dental_Product_and_Lab__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
