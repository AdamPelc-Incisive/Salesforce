    <recordUpdates>
        <description>Point the practice at its new corporate parent. Both pointers are set: ParentId is what the numbering flow branches on, Corporate_Parent_Account__c is what the rest of the org reads. Safe to run here - the practice&#39;s Generate_Account_Numbers__c is still false, so this update does not trip the numbering flow early.</description>
        <name>Link_Practice_To_Corp</name>
        <label>Link Practice To Corp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Seed_Corp_Into_Collection</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Line_Items</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Corporate_Parent_Account__c</field>
            <value>
                <elementReference>Create_Corporate_Parent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>Create_Corporate_Parent</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
