    <recordCreates>
        <description>The corporate account above this practice. Mirrors the New Account button in reverse, minus the addresses - a corporate carrying a clinic&#39;s address is how hardware gets shipped to a holding company. The Name is copied as-is; the numbering flow appends &quot; - Corp&quot; when it stamps Corporate_ID__c. Deliberately does NOT set Generate_Account_Numbers__c here - Account_Before_Set_Initial_Corporate_Practice_IDs only fires on a genuine false-&gt;true transition of that field (doesRequireRecordChangedToMeetCriteria). Setting it true at insert and again, unchanged, in the later Update_Accounts DML is a no-op transition and silently skips numbering. Stamp_ID is what flips it, the same way it already does for the practice.</description>
        <name>Create_Corporate_Parent</name>
        <label>Create Corporate Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Link_Practice_To_Corp</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Line_Items</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Account_Level__c</field>
            <value>
                <stringValue>Corporate</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_is_Associated_with_a_Specialist__c</field>
            <value>
                <elementReference>Get_Opp_Account.Account_is_Associated_with_a_Specialist__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Existing_Scanner_Type_Other__c</field>
            <value>
                <elementReference>Get_Opp_Account.Existing_Scanner_Type_Other__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Existing_Scanner_Type__c</field>
            <value>
                <elementReference>Get_Opp_Account.Existing_Scanner_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Existing_Scanners_in_Office__c</field>
            <value>
                <elementReference>Get_Opp_Account.Existing_Scanners_in_Office__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Group_Website__c</field>
            <value>
                <elementReference>Get_Opp_Account.Website</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Get_Opp_Account.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Opp_Account.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Straumann_Customer_Number__c</field>
            <value>
                <elementReference>Get_Opp_Account.Straumann_Customer_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <elementReference>Get_Opp_Account.Type</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
