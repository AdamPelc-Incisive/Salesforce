<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When an account is added/updated on an asset check if that account has a corporate parent; if so stamp the corporate parent on the asset.</description>
    <environments>Default</environments>
    <interviewLabel>Asset - Before - Set Corporate Parent {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Asset - Before - Set Corporate Parent</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Corporate_Parent</name>
        <label>Set Corporate Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Corporate_Parent__c</field>
            <value>
                <elementReference>$Record.Account.Corporate_Parent_Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Corporate_Parent</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.AccountId})),
  OR(
    ISBLANK({!$Record__Prior.Id}), 
    {!$Record.AccountId} &lt;&gt; {!$Record__Prior.AccountId}
  )
)</filterFormula>
        <object>Asset</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
