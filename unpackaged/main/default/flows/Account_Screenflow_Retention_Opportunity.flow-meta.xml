    <description>Creates a Retention opportunity for an account. Selects scanner assets, creates OLIs from the standard pricebook, stamps Initial Amount, and navigates to the new opportunity.</description>
    <environments>Default</environments>
    <formulas>
        <name>closeDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>oliDescription</name>
        <dataType>String</dataType>
        <expression>{!loopSelectedAssets.Name} &amp; &quot; (&quot; &amp; {!loopSelectedAssets.SerialNumber} &amp; &quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>opportunityName</name>
        <dataType>String</dataType>
        <expression>{!getAccount.Name} &amp; &quot; - Retention - &quot; &amp; TEXT(YEAR(TODAY())) &amp; &quot;-&quot; &amp; IF(MONTH(TODAY()) &lt; 10, &quot;0&quot; &amp; TEXT(MONTH(TODAY())), TEXT(MONTH(TODAY()))) &amp; &quot;-&quot; &amp; IF(DAY(TODAY()) &lt; 10, &quot;0&quot; &amp; TEXT(DAY(TODAY())), TEXT(DAY(TODAY())))</expression>
    </formulas>
    <formulas>
        <name>statusChangeNote</name>
        <dataType>String</dataType>
        <expression>&quot;Downsell opportunity created by &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot; on &quot; &amp; TEXT({!$Flow.CurrentDate})</expression>
    </formulas>
    <formulas>
        <name>unitPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(ISNULL({!loopSelectedAssets.Usage_Minimum__c}), 0, {!loopSelectedAssets.Usage_Minimum__c})</expression>
        <scale>0</scale>
    </formulas>
