<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>addToAssetsToUpdate</name>
        <label>Add to Assets to Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>assetUpdateRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopPendingDownsellAssets</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>buildOliAssetIds</name>
        <label>Build OLI Asset IDs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>oliAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>|</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>oliAssetIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>loopOlis.Original_Asset__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopOlis</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>buildOrphanedAssetUpdate</name>
        <label>Build Orphaned Asset Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopPendingDownsellAssets.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending Return</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status_Change_Notes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Scanner downgraded via retention opportunity</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>addToAssetsToUpdate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>buildWonAssetUpdate</name>
        <label>Build Won Asset Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopPendingDownsellAssets.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Deployed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status_Change_Notes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Retention opportunity won</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>addToAssetsToUpdate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>resetAssetUpdateRecord</name>
        <label>Reset Asset Update Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>emptyAssetRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>isAssetOnOli</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>hasAssetsToUpdate</name>
        <label>Has Assets to Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>hasAssetsToUpdateYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>assetsToUpdate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateOrphanedAssets</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>hasPendingDownsellAssets</name>
        <label>Has Pending Downsell Assets?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>hasPendingDownsellAssetsYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getPendingDownsellAssets</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getOlisWithOriginalAsset</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>isAssetOnOli</name>
        <label>Is Asset on OLI?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>buildOrphanedAssetUpdate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not on OLI</defaultConnectorLabel>
        <rules>
            <name>isAssetOnOliFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>oliAssetIds</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>loopPendingDownsellAssets.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>buildWonAssetUpdate</targetReference>
            </connector>
            <label>Found on OLI</label>
        </rules>
    </decisions>
    <description>When a Retention opportunity is Closed Won, update all linked Pending Downsell assets: assets still on an OLI move to Deployed (retention won); assets no longer on any OLI (scanner swapped out) move to Pending Return</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - After - Update Pending Downsell Assets on Closed Won Retention {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - After - Update Pending Downsell Assets on Closed Won Retention</label>
    <loops>
        <name>loopOlis</name>
        <label>Loop OLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getOlisWithOriginalAsset</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>buildOliAssetIds</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>loopPendingDownsellAssets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loopPendingDownsellAssets</name>
        <label>Loop Pending Downsell Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getPendingDownsellAssets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>resetAssetUpdateRecord</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>hasAssetsToUpdate</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getOlisWithOriginalAsset</name>
        <label>Get OLIs with Original Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>loopOlis</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Original_Asset__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getPendingDownsellAssets</name>
        <label>Get Pending Downsell Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>hasPendingDownsellAssets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Downgrade_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Downsell</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>updateOrphanedAssets</name>
        <label>Update Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>assetsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getPendingDownsellAssets</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
        <filters>
            <field>Record_Type_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Retention</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>assetsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>assetUpdateRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>emptyAssetRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>oliAssetIds</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
