    <environments>Default</environments>
    <formulas>
        <name>labMatchFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!recordId.Works_with_Labs__c}, {!labLoop}), {!labLoop} &amp; &quot;;&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>onboardingName</name>
        <dataType>String</dataType>
        <expression>{!recordId.Name} &amp; &quot; - RCA - &quot; &amp; TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>scannerMatchFormula</name>
        <dataType>String</dataType>
        <expression>IF(OR({!scannerLoop.Product2.Name} = &quot;ICAM&quot;, {!scannerLoop.Product2.Name} = &quot;Trios 3&quot;, {!scannerLoop.Product2.Name} = &quot;Trios 5&quot;, {!scannerLoop.Product2.Name} = &quot;Trios 6&quot;, {!scannerLoop.Product2.Name} = &quot;X3&quot;, {!scannerLoop.Product2.Name} = &quot;Trios Core&quot;), {!scannerLoop.Product2.Name} &amp; &quot;;&quot;, &quot;&quot;)</expression>
    </formulas>
