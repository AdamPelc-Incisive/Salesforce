    <decisions>
        <name>hasChildAssets</name>
        <label>Has Child Assets?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>updateAssets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>hasChildAssetsYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getChildAssets</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loopChildAssets</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>hasPendingUpsellAssets</name>
        <label>Has Pending Upsell Assets?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>hasPendingUpsellAssetsYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getPendingUpsellAssets</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loopPendingUpsellAssets</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>isClosedWon</name>
        <label>Closed Won?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>updateAssets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Closed Lost</defaultConnectorLabel>
        <rules>
            <name>isClosedWonYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getChildAssets</targetReference>
            </connector>
            <label>Closed Won</label>
        </rules>
    </decisions>
    <description>When a Scanner Upgrade opportunity is closed, update linked Pending Upsell assets: Closed Won marks them (and child laptops) Pending Return so they appear in Process Return; Closed Lost reverts them to Deployed so the practice keeps the old scanner. Looks up assets by Amendment Opportunity, not opportunity products. (INC3-178)</description>
    <environments>Default</environments>
    <formulas>
        <name>newStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.StageName}) = &quot;Closed Won&quot;, &quot;Pending Return&quot;, &quot;Deployed&quot;)</expression>
    </formulas>
    <formulas>
        <name>statusChangeNote</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.StageName}) = &quot;Closed Won&quot;, &quot;Scanner upgraded via expansion opportunity&quot;, &quot;Upgrade opportunity lost&quot;)</expression>
    </formulas>
    <interviewLabel>Opportunity - After - Update Pending Upsell on Closed Upgrade {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - After - Update Pending Upsell on Closed Upgrade</label>
    <loops>
        <name>loopChildAssets</name>
        <label>Loop Child Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getChildAssets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>resetAssetUpdateRecordForChild</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>updateAssets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loopPendingUpsellAssets</name>
        <label>Loop Pending Upsell Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>getPendingUpsellAssets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>resetAssetUpdateRecordForParent</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>isClosedWon</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getChildAssets</name>
        <label>Get Child Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>hasChildAssets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>In</operator>
            <value>
                <elementReference>parentIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>getPendingUpsellAssets</name>
        <label>Get Pending Upsell Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>hasPendingUpsellAssets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Downgrade_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending Upsell</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Asset</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>updateAssets</name>
        <label>Update Assets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>assetsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getPendingUpsellAssets</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Scanner Upgrade</stringValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Lost</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>assetsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>assetUpdateRecord</name>
