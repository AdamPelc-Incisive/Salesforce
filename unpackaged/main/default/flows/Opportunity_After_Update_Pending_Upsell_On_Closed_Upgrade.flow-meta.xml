    <assignments>
        <name>buildParentAssetUpdate</name>
        <label>Build Parent Asset Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopPendingUpsellAssets.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>assetUpdateRecord.Status</assignToReference>
            <operator>Assign</operator>
