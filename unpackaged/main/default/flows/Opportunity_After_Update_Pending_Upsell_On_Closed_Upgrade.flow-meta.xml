            <targetReference>buildChildAssetUpdate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>resetAssetUpdateRecordForParent</name>
        <label>Reset Asset Update Record for Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>assetUpdateRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>emptyAssetRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>buildParentAssetUpdate</targetReference>
        </connector>
