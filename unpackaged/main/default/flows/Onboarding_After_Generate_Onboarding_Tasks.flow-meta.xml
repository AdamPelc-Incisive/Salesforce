            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>onboardingTaskToCreate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>emptyTaskRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>onboardingTaskToCreate.Onboarding__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
